# Psychological Stress AI Configuration

PROJECT_NAME="Psychological Stress AI"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & JWT
SECRET_KEY=dev-secret-key-change-me-in-prod-2026!@#$
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite+aiosqlite:///./stress_ai.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://stress_user:stress_password@localhost:5432/stress_ai_db

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Next.js API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Conversation bot LLM (optional — offline fallback works without keys).
# Never put these in frontend code; backend only.
# CONVERSATION_LLM_API_KEY=sk-...
# CONVERSATION_LLM_BASE_URL=https://api.openai.com/v1
# CONVERSATION_LLM_MODEL=gpt-4o-mini
# CONVERSATION_LLM_TIMEOUT_S=20
# Server-side speech-to-text fallback for browsers without working
# transcription (e.g. Brave). "local" = on-server Whisper, no key needed
# (pip install faster-whisper; model downloads once on first use).
# STT_PROVIDER=local
# STT_MODEL=tiny.en
# STT_DEVICE=cpu
# STT_COMPUTE=int8
# STT_MODEL_DIR=
# Or cloud Whisper (needs key):
# STT_PROVIDER=openai
# STT_OPENAI_API_KEY=sk-...
# STT_OPENAI_MODEL=whisper-1
# STT_OPENAI_BASE_URL=https://api.openai.com/v1
# STT_TIMEOUT_S=30
# STT_MAX_MB=10
# In-memory conversation/live-voice session idle expiry (minutes).
# CONVERSATION_SESSION_TTL_MIN=30
